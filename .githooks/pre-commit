#!/bin/sh

# Pre-commit hook: eslint --fix untuk file JS/Vue yang di-stage, pint untuk file PHP yang di-stage, lalu re-stage.
# Commit di-blokir jika masih ada error lint/pint.

FAILED=0

if ! git diff --cached --name-only --diff-filter=ACM -z \
    | grep -z -E '\.(js|vue)$' \
    | xargs -0 -r -n 20 npx eslint --fix; then
    FAILED=1
fi

if ! git diff --cached --name-only --diff-filter=ACM -z \
    | grep -z -E '\.php$' \
    | xargs -0 -r -n 20 ./vendor/bin/pint; then
    FAILED=1
fi

# Re-stage file yang diperbaiki hook
git diff --cached --name-only --diff-filter=ACM -z \
    | grep -z -E '\.(js|vue|php)$' \
    | xargs -0 -r -n 20 git add -- || true

if [ "$FAILED" -ne 0 ]; then
    echo "Pre-commit hook: lint/pint gagal. Perbaiki error lalu commit ulang."
    exit 1
fi

exit 0
